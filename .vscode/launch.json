{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "command": "npm run dev",
      "name": "NPM",
      "request": "launch",
      "type": "node-terminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "command": "npm run dev",
      "name": "NPM TEST",
      "request": "launch",
      "type": "node-terminal",
      "envFile": "${workspaceFolder}/.env.test"
    },
    {
      "command": "npm run dev",
      "name": "NPM LIVE",
      "request": "launch",
      "type": "node-terminal",
      "envFile": "${workspaceFolder}/.env.production"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Localhost",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}"
    },
    {
      "command": "npm run build",
      "name": "BUILD TEST",
      "request": "launch",
      "type": "node-terminal",
      "envFile": "${workspaceFolder}/.env.test"
    },
    {
      "command": "npm run build",
      "name": "BUILD PROD",
      "request": "launch",
      "type": "node-terminal",
      "envFile": "${workspaceFolder}/.env.production"
    }
  ],
  "compounds": [
    {
      "name": "== Localhost ==",
      "configurations": ["NPM", "Localhost"]
    },
    {
      "name": "== Test ==",
      "configurations": ["NPM TEST", "Localhost"]
    },
    {
      "name": "== Live ==",
      "configurations": ["NPM LIVE", "Localhost"]
    }
  ]
}
